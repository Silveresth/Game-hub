# Copier en .env (jamais dans git) et remplir.

# Domaine public du jeu (le DNS doit pointer vers le serveur)
DOMAIN=jeu.example.com

# Mot de passe du panneau /admin/ (long et aléatoire). Sans lui, l'admin est désactivé.
SAM_ADMIN_TOKEN=

# Contact des notifications push, exigé par les services de push : mailto:… ou une URL
SAM_VAPID_SUBJECT=mailto:contact@example.com

# Facultatif : « Se connecter avec Google » (identifiant client OAuth, type « Application Web »)
SAM_GOOGLE_CLIENT_ID=

# Facultatif : APK Android (Trusted Web Activity). Nom du paquet et empreinte(s) SHA-256 de la clé de signature
SAM_ANDROID_PACKAGE=
SAM_ANDROID_SHA256=

# PostgreSQL (Neon ou autre) : tout l'état durable en base, plus besoin de disque (voir docs/DEPLOIEMENT.md)
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# Comptes : e-mails « mot de passe oublié » envoyés par Brevo (voir docs/DEPLOIEMENT.md, étape 5)
# SAM_PUBLIC_URL=https://jouer.mondomaine.fr
# BREVO_API_KEY=
# SAM_MAIL_FROM=noreply@mondomaine.fr
# SAM_MAIL_FROM_NAME=Steal a Masterpiece

# Page d'accueil hébergée sur un autre domaine (Vercel) : domaines autorisés à lire /api/live et /api/stats
# SAM_CORS_ORIGINS=https://mondomaine.fr,https://www.mondomaine.fr,*.vercel.app

# En-tête de l'hébergeur portant la vraie adresse du client (facultatif, avec SAM_TRUST_PROXY=1)
# SAM_CLIENT_IP_HEADER=

# Plusieurs proxys en chaîne devant le jeu (CDN + Caddy…) : nombre d'adresses à ignorer en fin de X-Forwarded-For
# SAM_PROXY_HOPS=1
