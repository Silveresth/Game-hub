# Copier en .env (jamais dans git) et remplir.

# Domaine public du jeu (le DNS doit pointer vers le serveur)
DOMAIN=jeu.example.com

# Mot de passe du panneau /admin/ (long et aléatoire). Sans lui, l'admin est désactivé.
SAM_ADMIN_TOKEN=

# Contact des notifications push, exigé par les services de push : mailto:… ou une URL
SAM_VAPID_SUBJECT=mailto:contact@example.com

# Facultatif : « Se connecter avec Google » (identifiant client OAuth, type « Application Web »)
SAM_GOOGLE_CLIENT_ID=

# Facultatif : APK Android (Trusted Web Activity). Nom du paquet et empreinte(s) SHA-256 de la clé de signature
SAM_ANDROID_PACKAGE=
SAM_ANDROID_SHA256=

# Persistance avancée (optionnelle pour grand nombre de joueurs)
# DATABASE_URL=postgresql://sam_user:sam_pass@postgres:5432/sam_db
# REDIS_URL=redis://redis:6379
